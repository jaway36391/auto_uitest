# Exchange UI Patrol - 环境配置模板
# 复制此文件为 .env.production 或 .env.staging 并填入实际值
# 所有配置项均使用 PATROL_ 前缀

# ============================================================
# 基础配置
# ============================================================

# 目标环境: production | staging
PATROL_ENV=staging

# 目标环境基础URL
PATROL_BASE_URL=https://www.example.com

# 全局超时时间(毫秒)
PATROL_TIMEOUT=30000

# 是否无头模式运行浏览器 (true/false)
PATROL_HEADLESS=true

# 操作延迟(毫秒)，调试时可设置为非0值
PATROL_SLOW_MO=0

# ============================================================
# 测试账号配置
# ============================================================

# 测试账号用户名
PATROL_TEST_USERNAME=your_test_username@example.com

# 测试账号密码
PATROL_TEST_PASSWORD=your_test_password

# TOTP 密钥（用于两步验证）
PATROL_TOTP_SECRET=your_totp_secret

# 设备ID（用于设备认证）
PATROL_DEVICE_ID=your_device_id

# 认证Token（用于API认证）
PATROL_AUTH_TOKEN=your_auth_token

# ============================================================
# 报告配置
# ============================================================

# 报告输出目录
PATROL_REPORT_DIR=reports

# 失败时是否自动截图 (true/false)
PATROL_SCREENSHOT_ON_FAILURE=true

# ============================================================
# 告警通知配置
# ============================================================

# 企业微信 Webhook URL（留空则不发送）
PATROL_WECOM_WEBHOOK_URL=

# 钉钉 Webhook URL（留空则不发送）
PATROL_DINGTALK_WEBHOOK_URL=

# 失败时是否发送告警 (true/false)
PATROL_ALERT_ON_FAILURE=true

# ============================================================
# AI Agent 配置（browser-use + LLM）
# ============================================================

# LLM 提供商: openai | anthropic
AI_PROVIDER=openai

# OpenAI 配置
AI_OPENAI_API_KEY=your_openai_api_key
AI_OPENAI_MODEL=gpt-4o
# AI_OPENAI_BASE_URL=https://your-proxy.com/v1  # 可选：代理地址

# Anthropic 配置
AI_ANTHROPIC_API_KEY=your_anthropic_api_key
AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent 行为配置
AI_MAX_STEPS=20
AI_USE_VISION=true
